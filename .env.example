STEAM_API_KEY=your_steam_web_api_key
STEAM_ID=your_steamid64

# Optional login gate — leave unset/false if the app is only reachable over
# Tailscale (Tailscale itself is already the access control in that case).
# STEAMHTB_LOGIN=true
# STEAMHTB_LOGIN_PASSWORD=choose_a_password
# How long a login session lasts before you need to log in again (default 180).
# STEAMHTB_SESSION_DAYS=180
# Only set this once the app is served over HTTPS (e.g. behind Nginx Proxy
# Manager) — over plain HTTP the cookie would never get sent back.
# STEAMHTB_COOKIE_SECURE=true
